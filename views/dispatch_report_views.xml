<odoo>
    <record id="view_dispatch_report_list" model="ir.ui.view">
        <field name="name">dispatch.report.list</field>
        <field name="model">dispatch.report</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="product_id"/>
                <field name="product_barcode" optional="show"/>
                <field name="internal_reference" optional="show"/>
                <field name="total_demand"/>
                <field name="qty_delivered"/>
                <field name="qty_to_deliver"/>
                <field name="uom_id" optional="show"/>
                <field name="fiscal_position_id" optional="hide"/>
                <field name="payment_term_id" optional="hide"/>
                <field name="schedule_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_dispatch_report" model="ir.actions.act_window">
        <field name="name">Dispatch Report</field>
        <field name="res_model">dispatch.report</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_dispatch_report" name="Dispatch Report"
              parent="stock.menu_stock_root" action="action_dispatch_report" sequence="20"/>
</odoo>